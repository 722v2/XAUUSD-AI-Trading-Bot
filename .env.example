APP_ENV=development
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info

# Local MT5 bridge: set the same random token in both processes.
MT5_BRIDGE_URL=http://127.0.0.1:8765
MT5_BRIDGE_TOKEN=

# Automated trading safety limits are mandatory; auto execution stays disabled if either is missing.
# Loss percent is measured against account balance; streak counts consecutive closed bot deals.
MAX_DAILY_LOSS_PERCENT=
MAX_CONSECUTIVE_LOSSES=

# AI provider. Credentials stay server-side.
AI_PROVIDER_ID=
AI_MODEL_ID=
AI_BASE_URL=
AI_API_KEY=

# Optional persistent storage; server-side only.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional Telegram Bot API integration; server-side only.
TELEGRAM_BOT_TOKEN=

# Optional allowlist for UI model choices on a single OpenAI-compatible endpoint:
# AI_ALLOWED_MODELS=model-a,model-b,provider/model-c
# Optional multi-provider allowlist. apiKeyEnv names environment variables; never place key values here.
# AI_PROVIDER_CATALOG_JSON=[{"id":"openrouter","label":"OpenRouter","baseUrl":"https://openrouter.ai/api/v1","apiKeyEnv":"OPENROUTER_API_KEY","models":[{"id":"provider/model","label":"Example model"}]}]
# OPENROUTER_API_KEY must be configured separately in the server environment.
