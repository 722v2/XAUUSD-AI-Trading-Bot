APP_ENV=development
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info

# Local MT5 bridge: set the same random token in both processes.
MT5_BRIDGE_URL=http://127.0.0.1:8765
MT5_BRIDGE_TOKEN=

# AI provider. Credentials stay server-side.
AI_PROVIDER_ID=
AI_MODEL_ID=
AI_BASE_URL=
AI_API_KEY=

# Optional persistent storage; server-side only.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional Telegram Bot API integration; server-side only.
TELEGRAM_BOT_TOKEN=
