APP_ENV=development
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info

# Legacy bridge compatibility only. Do not launch the legacy bridge while validating V2 unless explicitly needed for rollback.
MT5_BRIDGE_URL=http://127.0.0.1:8765
MT5_BRIDGE_TOKEN=
MT5_BRIDGE_HOST=127.0.0.1
MT5_BRIDGE_PORT=8765
MT5_LOCAL_BRIDGE_URL=http://127.0.0.1:8765
MT5_RELAY_SERVER_URL=https://xauusd-ai-trading-bot-preview.onrender.com
MT5_RELAY_WORKERS=4
MT5_RELAY_POLL_SECONDS=0.5
MT5_SYMBOL=XAUUSD.m

# Bridge V2: start_bridge_v2.bat runs the Windows agent. It opens outbound HTTPS only;
# no tunnel, port forwarding, or local public listener is needed.
# Use the same strong secret as Render's MT5_BRIDGE_TOKEN; never commit the real .env.
MT5_AGENT_ID=windows-mt5-demo-01
MT5_HEARTBEAT_SECONDS=10
MT5_OUTBOX_PATH=mt5_bridge_v2/outbox.sqlite3
# Optional absolute path to terminal64.exe if MT5 auto-discovery fails.
# MT5_TERMINAL_PATH=C:\\Program Files\\MetaTrader 5\\terminal64.exe

# Dashboard can request either DEMO or LIVE. The bridge verifies the actual
# MT5 account and blocks execution when the selected environment does not match.
MT5_EXECUTION_ENVIRONMENT=DEMO
# To make LIVE selectable, explicitly enable it and set the exact confirmation below.
MT5_LIVE_TRADING_ENABLED=false
MT5_LIVE_CONFIRMATION=I_UNDERSTAND_LIVE_TRADING_RISK

# Server-side settings on Render (set these in the Render dashboard, not here).
# LIVE_TRADING_ENABLED=false
# LIVE_TRADING_CONFIRMATION=I_UNDERSTAND_LIVE_TRADING_RISK

# Automated trading safety limits are mandatory; auto execution stays disabled if either is missing.
MAX_DAILY_LOSS_PERCENT=
MAX_CONSECUTIVE_LOSSES=
FINNHUB_API_KEY=

# AI provider. Credentials stay server-side.
AI_PROVIDER_ID=
AI_MODEL_ID=
AI_BASE_URL=
AI_API_KEY=
# AI request timeout in milliseconds (1000–45000; default 30000).
AI_REQUEST_TIMEOUT_MS=30000

# Optional persistent storage; server-side only.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional Telegram Bot API integration; server-side only.
TELEGRAM_BOT_TOKEN=

# Optional allowlist for UI model choices on a single OpenAI-compatible endpoint:
# AI_ALLOWED_MODELS=model-a,model-b,provider/model-c
# Optional multi-provider allowlist. apiKeyEnv names environment variables; never place key values here.
# AI_PROVIDER_CATALOG_JSON=[{"id":"openrouter","label":"OpenRouter","baseUrl":"https://openrouter.ai/api/v1","apiKeyEnv":"OPENROUTER_API_KEY","models":[{"id":"provider/model","label":"Example model"}]}]
# OPENROUTER_API_KEY must be configured separately in the server environment.
